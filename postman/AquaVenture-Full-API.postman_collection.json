{
  "info": {
    "name": "AquaVenture - Full API Collection",
    "description": "Complete, hand-verified API collection for the AquaVenture backend: auth for all 4 roles (Admin/Provider/Instructor/Surfer), user management, surf locations, bookings lifecycle, provider/tourist profiles, activities, instructors, equipment, weather, recommendations, and surf progress. Import into Postman, run the Login/Register requests in folder 1 once each (their test scripts auto-save tokens and IDs as collection variables), then everything else works out of the box against a locally running backend (default baseUrl: http://localhost:8080/api).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "adminToken", "value": "" },
    { "key": "providerToken", "value": "" },
    { "key": "surferToken", "value": "" },
    { "key": "instructorToken", "value": "" },
    { "key": "instructorEmail", "value": "browsertest_instructor@example.com" },
    { "key": "instructorPassword", "value": "Passw0rd!" },
    { "key": "adminEmail", "value": "admin@aquaventure.com" },
    { "key": "adminPassword", "value": "Passw0rd!" },
    { "key": "providerEmail", "value": "browsertest_provider@example.com" },
    { "key": "providerPassword", "value": "Passw0rd!" },
    { "key": "surferEmail", "value": "browsertest_surfer@example.com" },
    { "key": "surferPassword", "value": "Passw0rd!" },
    { "key": "providerId", "value": "" },
    { "key": "touristId", "value": "" },
    { "key": "locationId", "value": "1" },
    { "key": "activityId", "value": "1" },
    { "key": "instructorId", "value": "1" },
    { "key": "equipmentId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.token);",
                  "pm.test('login succeeded', () => pm.response.code === 200);",
                  "pm.test('role is ADMIN', () => body.role === 'ADMIN');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register Provider (for testing)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Surf Provider\",\n  \"email\": \"test_provider@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"role\": \"PROVIDER\",\n  \"businessName\": \"Test Surf Co\",\n  \"contactDetails\": \"0771234567\",\n  \"location\": \"Weligama\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login as Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('providerToken', body.token);",
                  "pm.collectionVariables.set('providerId', body.profileId);",
                  "pm.test('login succeeded', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register Instructor (for testing, requires providerId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Instructor Account\",\n  \"email\": \"{{instructorEmail}}\",\n  \"password\": \"{{instructorPassword}}\",\n  \"role\": \"INSTRUCTOR\",\n  \"providerId\": {{providerId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login as Instructor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('instructorToken', body.token);",
                  "pm.test('login succeeded', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{instructorEmail}}\",\n  \"password\": \"{{instructorPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register Surfer (for testing)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Surfer\",\n  \"email\": \"test_surfer@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"role\": \"SURFER\",\n  \"skillLevel\": \"BEGINNER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login as Surfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('surferToken', body.token);",
                  "pm.collectionVariables.set('touristId', body.profileId);",
                  "pm.test('login succeeded', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{surferEmail}}\",\n  \"password\": \"{{surferPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get My Account (/auth/me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test_surfer@example.com\",\n  \"newPassword\": \"NewPassw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "List All Users (ADMIN only)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get My Account (/users/me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update My Account",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"phoneNumber\": \"0770000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "3. Surf Locations",
      "item": [
        {
          "name": "List All Locations (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/locations", "host": ["{{baseUrl}}"], "path": ["locations"] }
          }
        },
        {
          "name": "Get Location by Id (public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Create Location (ADMIN or PROVIDER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locationName\": \"Arugam Bay\",\n  \"difficultyLevel\": \"INTERMEDIATE\",\n  \"safetyRating\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/locations", "host": ["{{baseUrl}}"], "path": ["locations"] }
          }
        },
        {
          "name": "Update Location (ADMIN or PROVIDER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locationName\": \"Arugam Bay Main Point\",\n  \"difficultyLevel\": \"INTERMEDIATE\",\n  \"safetyRating\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Delete Location (ADMIN only)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Bookings - Ledger / Search",
      "item": [
        {
          "name": "List All Bookings (no filter)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Search Bookings by Tourist",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?touristId={{touristId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [{ "key": "touristId", "value": "{{touristId}}" }]
            }
          }
        },
        {
          "name": "Search Bookings by Provider",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?providerId={{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [{ "key": "providerId", "value": "{{providerId}}" }]
            }
          }
        },
        {
          "name": "Search Bookings by Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        },
        {
          "name": "Get Booking by Id",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"]
            }
          }
        }
      ]
    },
