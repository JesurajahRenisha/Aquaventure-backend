              "path": ["tourists", "{{touristId}}"]
            }
          }
        },
        {
          "name": "Update Tourist Profile (ADMIN or SURFER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillLevel\": \"INTERMEDIATE\",\n  \"experience\": \"2 years surfing in Sri Lanka\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tourists/{{touristId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tourists", "{{touristId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Surf Activities (services)",
      "item": [
        {
          "name": "Search Activities (all/filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities?providerId={{providerId}}&locationId={{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["activities"],
              "query": [
                { "key": "providerId", "value": "{{providerId}}", "disabled": true },
                { "key": "locationId", "value": "{{locationId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Activity by Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}"]
            }
          }
        },
        {
          "name": "Create Activity (PROVIDER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locationId\": {{locationId}},\n  \"activityName\": \"Beginner Surf Lesson\",\n  \"price\": 25,\n  \"duration\": 60,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/activities", "host": ["{{baseUrl}}"], "path": ["activities"] }
          }
        },
        {
          "name": "Update Activity (PROVIDER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locationId\": {{locationId}},\n  \"activityName\": \"Beginner Surf Lesson (updated)\",\n  \"price\": 30,\n  \"duration\": 90,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}"]
            }
          }
        },
        {
          "name": "Delete Activity (PROVIDER)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}"]
            }
          }
        }
      ]
    },
