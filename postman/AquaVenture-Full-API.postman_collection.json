    {
      "name": "9. Bookings (create + lifecycle)",
      "item": [
        {
          "name": "Create Booking (SURFER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.bookingId) pm.collectionVariables.set('bookingId', body.bookingId);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{surferToken}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": {{activityId}},\n  \"bookingDate\": \"2026-09-01T09:00:00\"\n}"
            },
