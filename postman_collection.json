{
  "info": {
    "name": "AquaVenture API",
    "description": "Surf tourist / surf school platform API. Base URL defaults to http://localhost:8080/api. Login requests auto-save their token into the matching collection variable via a test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "surferToken", "value": "" },
    { "key": "schoolAdminToken", "value": "" },
    { "key": "platformAdminToken", "value": "" },
    { "key": "locationId", "value": "1" },
    { "key": "schoolId", "value": "1" },
    { "key": "instructorId", "value": "1" },
    { "key": "lessonId", "value": "1" },
    { "key": "lessonSlotId", "value": "1" },
    { "key": "equipmentId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "progressEntryId", "value": "1" },
    { "key": "notificationId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "documentIndex", "value": "0" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Surfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Nimal\",\n  \"lastname\": \"Silva\",\n  \"email\": \"nimal.surf@example.com\",\n  \"password\": \"Password1!\",\n  \"phone\": \"0771234567\",\n  \"nationality\": \"Sri Lanka\",\n  \"local\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register/surfer", "host": ["{{baseUrl}}"], "path": ["auth", "register", "surfer"] }
          }
        },
        {
          "name": "Register School (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "ownerFirstname", "value": "Kasun", "type": "text" },
                { "key": "ownerLastname", "value": "Perera", "type": "text" },
                { "key": "email", "value": "kasun.school@example.com", "type": "text" },
                { "key": "password", "value": "Password1!", "type": "text" },
                { "key": "schoolName", "value": "Arugam Surf Co", "type": "text" },
                { "key": "description", "value": "Friendly beginner-focused surf school", "type": "text" },
                { "key": "address", "value": "Main Street, Arugam Bay", "type": "text" },
                { "key": "contactPhone", "value": "0771112222", "type": "text" },
                { "key": "contactEmail", "value": "info@arugamsurf.com", "type": "text" },
                { "key": "businessRegistrationNumber", "value": "BRN-001", "type": "text" },
                { "key": "locationIds", "value": "1", "type": "text" },
                { "key": "documents", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/auth/register/school", "host": ["{{baseUrl}}"], "path": ["auth", "register", "school"] }
          }
        },
        {
          "name": "Login as Surfer",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const body = pm.response.json();", "if (body.data && body.data.token) { pm.collectionVariables.set('surferToken', body.data.token); }"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nimal.surf@example.com\",\n  \"password\": \"Password1!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as School Admin",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const body = pm.response.json();", "if (body.data && body.data.token) { pm.collectionVariables.set('schoolAdminToken', body.data.token); }", "if (body.data && body.data.schoolId) { pm.collectionVariables.set('schoolId', body.data.schoolId); }"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"kasun.school@example.com\",\n  \"password\": \"Password1!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Platform Admin",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const body = pm.response.json();", "if (body.data && body.data.token) { pm.collectionVariables.set('platformAdminToken', body.data.token); }"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@aquaventure.dev\",\n  \"password\": \"Admin@12345\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Public - Discovery & Conditions",
      "item": [
        {
          "name": "List Locations",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/locations", "host": ["{{baseUrl}}"], "path": ["locations"] } }
        },
        {
          "name": "Get Surf Conditions",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/locations/{{locationId}}/conditions", "host": ["{{baseUrl}}"], "path": ["locations", "{{locationId}}", "conditions"] } }
        },
        {
          "name": "Search Schools",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schools?locationId={{locationId}}&skillLevel=BEGINNER&lessonType=GROUP&minPrice=0&maxPrice=100&sort=name&page=0&size=20",
              "host": ["{{baseUrl}}"], "path": ["schools"],
              "query": [
                { "key": "locationId", "value": "{{locationId}}" },
                { "key": "skillLevel", "value": "BEGINNER" },
                { "key": "lessonType", "value": "GROUP" },
                { "key": "minPrice", "value": "0" },
                { "key": "maxPrice", "value": "100" },
                { "key": "sort", "value": "name" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get School Detail",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/schools/{{schoolId}}", "host": ["{{baseUrl}}"], "path": ["schools", "{{schoolId}}"] } }
        },
        {
          "name": "Compare Schools",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schools/compare?ids=1,2",
              "host": ["{{baseUrl}}"], "path": ["schools", "compare"],
              "query": [{ "key": "ids", "value": "1,2" }]
            }
          }
        },
        {
          "name": "Get Lesson Open Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/lessons/{{lessonId}}/slots?from=2026-11-01T00:00:00Z&to=2026-12-01T00:00:00Z",
              "host": ["{{baseUrl}}"], "path": ["lessons", "{{lessonId}}", "slots"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-12-01T00:00:00Z" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Surfer",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{surferToken}}" }] },
      "item": [
        {
          "name": "Get My Profile",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/surfer/me/profile", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "profile"] } }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"skillLevel\": \"BEGINNER\",\n  \"preferredLocationId\": {{locationId}},\n  \"preferredLessonType\": \"GROUP\",\n  \"budgetMin\": 20,\n  \"budgetMax\": 80,\n  \"boardTypePreference\": \"Softboard\",\n  \"bio\": \"New to surfing, excited to learn!\"\n}" },
            "url": { "raw": "{{baseUrl}}/surfer/me/profile", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "profile"] }
          }
        },
        {
          "name": "Get Recommendations",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/surfer/me/recommendations", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "recommendations"] } }
        },
        {
          "name": "Create Booking",
          "event": [
            { "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data && body.data.id) { pm.collectionVariables.set('bookingId', body.data.id); }"], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"lessonSlotId\": {{lessonSlotId}},\n  \"participants\": 2,\n  \"equipmentItems\": [\n    { \"equipmentId\": {{equipmentId}}, \"quantity\": 1, \"rentalUnit\": \"HOUR\" }\n  ],\n  \"note\": \"First time surfing!\"\n}" },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "List My Bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/surfer/me/bookings?status=PENDING",
              "host": ["{{baseUrl}}"], "path": ["surfer", "me", "bookings"],
              "query": [{ "key": "status", "value": "PENDING", "disabled": false }]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/surfer/me/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "bookings", "{{bookingId}}", "cancel"] } }
        },
        {
          "name": "List My Progress Entries",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/surfer/me/progress", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "progress"] } }
        },
        {
          "name": "Create Progress Entry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-10T09:00:00Z\",\n  \"locationId\": {{locationId}},\n  \"skillFocus\": \"Pop-up and balance\",\n  \"durationMinutes\": 90,\n  \"selfRating\": 3,\n  \"notes\": \"Stood up twice!\"\n}" },
            "url": { "raw": "{{baseUrl}}/surfer/me/progress", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "progress"] }
          }
        },
        {
          "name": "Update Progress Entry (fill in a draft)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-10T09:00:00Z\",\n  \"locationId\": {{locationId}},\n  \"skillFocus\": \"Pop-up and balance\",\n  \"durationMinutes\": 90,\n  \"selfRating\": 4,\n  \"notes\": \"Caught my first wave!\"\n}" },
            "url": { "raw": "{{baseUrl}}/surfer/me/progress/{{progressEntryId}}", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "progress", "{{progressEntryId}}"] }
          }
        },
        {
          "name": "Delete Progress Entry",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/surfer/me/progress/{{progressEntryId}}", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "progress", "{{progressEntryId}}"] } }
        },
        {
          "name": "Get Progress Summary",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/surfer/me/progress/summary", "host": ["{{baseUrl}}"], "path": ["surfer", "me", "progress", "summary"] } }
        }
      ]
    },
