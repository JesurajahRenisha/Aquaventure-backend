    {
      "name": "School Admin - Bookings & Dashboard",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{schoolAdminToken}}" }] },
      "item": [
        {
          "name": "List My School's Bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/school/me/bookings?status=PENDING",
              "host": ["{{baseUrl}}"], "path": ["school", "me", "bookings"],
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        },
        {
          "name": "Accept Booking",
          "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/school/me/bookings/{{bookingId}}/accept", "host": ["{{baseUrl}}"], "path": ["school", "me", "bookings", "{{bookingId}}", "accept"] } }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"No instructor available at that time\"\n}" },
            "url": { "raw": "{{baseUrl}}/school/me/bookings/{{bookingId}}/reject", "host": ["{{baseUrl}}"], "path": ["school", "me", "bookings", "{{bookingId}}", "reject"] }
          }
        },
        {
          "name": "Complete Booking",
          "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/school/me/bookings/{{bookingId}}/complete", "host": ["{{baseUrl}}"], "path": ["school", "me", "bookings", "{{bookingId}}", "complete"] } }
        },
        {
          "name": "Add Instructor Feedback to Progress Entry",
